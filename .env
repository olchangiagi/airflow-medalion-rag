# -----------------------------
# S3 Silver
# -----------------------------
AWS_REGION=ap-northeast-2
ECOMMERCE_BUCKET=de-ai-08-loggen-s3-bk-827913617635

# AWS credential chain.
# EC2 IAM Role을 사용하면 아래 키들은 비워둘 수 있습니다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# -----------------------------
# Embedding
# local   : 수업 즉시 실행용 1024차원 deterministic mock embedding
# bedrock : Amazon Titan Text Embeddings V2
# -----------------------------
EMBEDDING_PROVIDER=local
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_REGION=us-east-1

# -----------------------------
# PostgreSQL - host에서 테스트할 때 사용
# Docker 내부 DAG는 Airflow Connection(ecommerce_db)을 사용합니다.
# -----------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=ecommerce
DB_PASSWORD=ecommerce